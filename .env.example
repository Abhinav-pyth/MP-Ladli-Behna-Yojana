# Supabase Configuration
# This project supports BOTH Vite (VITE_*) and Next.js (NEXT_PUBLIC_*) prefixes
# Use whichever naming convention your Vercel project uses.
#
# Get these from: https://supabase.com/dashboard/ > Your Project > Settings > API

# Option A: Vite-style (recommended for this project)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Option B: Next.js-style (also supported)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
